Windows Registry Editor Version 5.00

; ============================================================
; FACELOOK — Credential Provider Registration
; ============================================================
; Run this file as Administrator to register the DLL.
; After registration, restart or lock the screen to see FACELOOK.
;
; To UNREGISTER, run: uninstall.reg (or delete the keys below)
; ============================================================

; 1. Register the COM class
[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\CLSID\{A1B2C3D4-E5F6-7890-ABCD-EF1234567890}]
@="FacelookCredentialProvider"

[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\CLSID\{A1B2C3D4-E5F6-7890-ABCD-EF1234567890}\InprocServer32]
@="C:\\FacelookBiometric\\CredentialProvider.dll"
"ThreadingModel"="Apartment"

; 2. Register as a Credential Provider
[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Authentication\Credential Providers\{A1B2C3D4-E5F6-7890-ABCD-EF1234567890}]
@="FacelookCredentialProvider"
